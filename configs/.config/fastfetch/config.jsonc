{
    // WARNING: All "key" fields and box-drawing "format" lines MUST use {##f1ed0b} for colors.
    // Using any other color variable (e.g. {##f1ed0b}) silently breaks the Nerd Font
    // icons — they disappear completely. {##f1ed0b} is the only safe token here.
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": {
            "1": "#f1ed0b",
            "2": "#f1ed0b"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        {
            "type": "custom",
            "format": "{##f1ed0b}┌─ 󰇅 HOST ───────────────────────────────────────┐"
        },
        {
            "type": "board",
            "key": "{##f1ed0b}󰆼 Motherboard"
        },
        {
            "type": "cpu",
            "key": "{##f1ed0b} CPU"
        },
        {
            "type": "gpu",
            "key": "{##f1ed0b}󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "{##f1ed0b} Memory"
        },
        {
            "type": "disk",
            "key": "{##f1ed0b}󰋊 Disk"
        },
        {
            "type": "display",
            "key": "{##f1ed0b}󰍹 Display"
        },
        {
            "type": "custom",
            "format": "{##f1ed0b}└────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": " ------------------------------------------------"
        },
        {
            "type": "custom",
            "format": "{##f1ed0b}┌─ 󰅐 RUNTIME ────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "{##f1ed0b}󰣇 OS"
        },
        {
            "type": "osage",
            "key": "{##f1ed0b}󰃰 OS Age"
        },
        {
            "type": "kernel",
            "key": "{##f1ed0b} Kernel"
        },
        {
            "type": "wm",
            "key": "{##f1ed0b}󰖲 WM"
        },
        {
            "type": "shell",
            "key": "{##f1ed0b} Shell"
        },
        {
            "type": "terminal",
            "key": "{##f1ed0b}󰆍 Terminal"
        },
        {
            "type": "uptime",
            "key": "{##f1ed0b}󰔚 Uptime"
        },
        {
            "type": "packages",
            "key": "{##f1ed0b}󰏖 Packages"
        },
        {
            "type": "custom",
            "format": "{##f1ed0b}└────────────────────────────────────────────────┘"
        }
    ]
}
