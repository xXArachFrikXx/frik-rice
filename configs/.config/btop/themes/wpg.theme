# Generated by scheme-apply.sh — edit variables, then re-run scheme-apply.sh
#
# Tune these in your .colors scheme file:
#   btop_lines    — box border color
#   btop_dividers — divider line color
#   btop_text     — graph labels and titles
#   btop_low/mid/high — gradient colors shared across all meters (cool → hot)

# === General UI ===
theme[main_bg]="#020202"                 # main background
theme[main_fg]="#b44fff"          # process name/command text
theme[title]="#9d9d9e"            # box/section titles
theme[hi_fg]="#f1ed0b"          # highlighted foreground text
theme[selected_bg]="#b44fff"      # selected process row background
theme[selected_fg]="#f1ed0b"             # selected process row text
theme[inactive_fg]="#3c3c3d"  # dimmed/inactive text
theme[graph_text]="#9d9d9e"       # graph axis labels
theme[meter_bg]="#3c3c3d"     # meter/bar track background
theme[proc_misc]="#9d9d9e"        # process list misc info (username, etc.)
theme[div_line]="#3c3c3d"     # divider lines between sections

# === Box borders (all use btop_lines) ===
theme[cpu_box]="#f1ed0b"   # CPU box border
theme[mem_box]="#f1ed0b"   # memory box border
theme[net_box]="#f1ed0b"   # network box border
theme[proc_box]="#f1ed0b"  # process list box border

# === All gradients use btop_low → btop_mid → btop_high ===

theme[temp_start]="#f1ed0b"  # low temp
theme[temp_mid]="#7a0a22"    # mid temp
theme[temp_end]="#b44fff"   # high temp

theme[cpu_start]="#f1ed0b"   # low usage
theme[cpu_mid]="#7a0a22"     # mid usage
theme[cpu_end]="#b44fff"    # high usage

theme[free_start]="#f1ed0b"  # low free memory
theme[free_mid]="#7a0a22"    # mid
theme[free_end]="#b44fff"   # high free memory

theme[cached_start]="#f1ed0b"  # low cached
theme[cached_mid]="#7a0a22"    # mid
theme[cached_end]="#b44fff"   # high cached

theme[available_start]="#f1ed0b"  # low available
theme[available_mid]="#7a0a22"    # mid
theme[available_end]="#b44fff"   # high available

theme[used_start]="#f1ed0b"  # low used
theme[used_mid]="#7a0a22"    # mid
theme[used_end]="#b44fff"   # high used

theme[download_start]="#f1ed0b"  # low download speed
theme[download_mid]="#7a0a22"    # mid
theme[download_end]="#b44fff"   # high download speed

theme[upload_start]="#f1ed0b"  # low upload speed
theme[upload_mid]="#7a0a22"    # mid
theme[upload_end]="#b44fff"   # high upload speed
