{
    // WARNING: All "key" fields and box-drawing "format" lines MUST use {accent1.fc} for colors.
    // Using any other color variable (e.g. {fastfetch_key.fc}) silently breaks the Nerd Font
    // icons — they disappear completely. {accent1.fc} is the only safe token here.
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": {
            "1": "{logo_color}",
            "2": "{logo_color}"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        {
            "type": "custom",
            "format": "{accent1.fc}┌─ 󰇅 HOST ───────────────────────────────────────┐"
        },
        {
            "type": "board",
            "key": "{accent1.fc}󰆼 Motherboard"
        },
        {
            "type": "cpu",
            "key": "{accent1.fc} CPU"
        },
        {
            "type": "gpu",
            "key": "{accent1.fc}󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "{accent1.fc} Memory"
        },
        {
            "type": "disk",
            "key": "{accent1.fc}󰋊 Disk"
        },
        {
            "type": "display",
            "key": "{accent1.fc}󰍹 Display"
        },
        {
            "type": "custom",
            "format": "{accent1.fc}└────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": " ------------------------------------------------"
        },
        {
            "type": "custom",
            "format": "{accent1.fc}┌─ 󰅐 RUNTIME ────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "{accent1.fc}󰣇 OS"
        },
        {
            "type": "osage",
            "key": "{accent1.fc}󰃰 OS Age"
        },
        {
            "type": "kernel",
            "key": "{accent1.fc} Kernel"
        },
        {
            "type": "wm",
            "key": "{accent1.fc}󰖲 WM"
        },
        {
            "type": "shell",
            "key": "{accent1.fc} Shell"
        },
        {
            "type": "terminal",
            "key": "{accent1.fc}󰆍 Terminal"
        },
        {
            "type": "uptime",
            "key": "{accent1.fc}󰔚 Uptime"
        },
        {
            "type": "packages",
            "key": "{accent1.fc}󰏖 Packages"
        },
        {
            "type": "custom",
            "format": "{accent1.fc}└────────────────────────────────────────────────┘"
        }
    ]
}
