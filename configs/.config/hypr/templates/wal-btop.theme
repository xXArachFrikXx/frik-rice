# Generated by scheme-apply.sh — edit variables, then re-run scheme-apply.sh
#
# Tune these in your .colors scheme file:
#   btop_lines    — box border color
#   btop_dividers — divider line color
#   btop_text     — graph labels and titles
#   btop_low/mid/high — gradient colors shared across all meters (cool → hot)

# === General UI ===
theme[main_bg]="{bg}"                 # main background
theme[main_fg]="{btop_proc}"          # process name/command text
theme[title]="{btop_text}"            # box/section titles
theme[hi_fg]="{btop_lines}"          # highlighted foreground text
theme[selected_bg]="{btop_high}"      # selected process row background
theme[selected_fg]="{fg}"             # selected process row text
theme[inactive_fg]="{btop_dividers}"  # dimmed/inactive text
theme[graph_text]="{btop_text}"       # graph axis labels
theme[meter_bg]="{btop_dividers}"     # meter/bar track background
theme[proc_misc]="{btop_text}"        # process list misc info (username, etc.)
theme[div_line]="{btop_dividers}"     # divider lines between sections

# === Box borders (all use btop_lines) ===
theme[cpu_box]="{btop_lines}"   # CPU box border
theme[mem_box]="{btop_lines}"   # memory box border
theme[net_box]="{btop_lines}"   # network box border
theme[proc_box]="{btop_lines}"  # process list box border

# === All gradients use btop_low → btop_mid → btop_high ===

theme[temp_start]="{btop_low}"  # low temp
theme[temp_mid]="{btop_mid}"    # mid temp
theme[temp_end]="{btop_high}"   # high temp

theme[cpu_start]="{btop_low}"   # low usage
theme[cpu_mid]="{btop_mid}"     # mid usage
theme[cpu_end]="{btop_high}"    # high usage

theme[free_start]="{btop_low}"  # low free memory
theme[free_mid]="{btop_mid}"    # mid
theme[free_end]="{btop_high}"   # high free memory

theme[cached_start]="{btop_low}"  # low cached
theme[cached_mid]="{btop_mid}"    # mid
theme[cached_end]="{btop_high}"   # high cached

theme[available_start]="{btop_low}"  # low available
theme[available_mid]="{btop_mid}"    # mid
theme[available_end]="{btop_high}"   # high available

theme[used_start]="{btop_low}"  # low used
theme[used_mid]="{btop_mid}"    # mid
theme[used_end]="{btop_high}"   # high used

theme[download_start]="{btop_low}"  # low download speed
theme[download_mid]="{btop_mid}"    # mid
theme[download_end]="{btop_high}"   # high download speed

theme[upload_start]="{btop_low}"  # low upload speed
theme[upload_mid]="{btop_mid}"    # mid
theme[upload_end]="{btop_high}"   # high upload speed
